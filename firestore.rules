rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección de proyectos
    match /projects/{projectId} {
      // Permitir lectura pública de proyectos en el catálogo
      allow read: if true;

      // Permitir creación y modificación solo a administradores autenticados con email verificado
      // y validando estructura mínima de proyecto
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll(['title', 'category', 'status'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200;

      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200));

      allow delete: if request.auth != null
        && request.auth.token.email_verified == true;
    }

    // Denegar acceso a todas las demás colecciones por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
