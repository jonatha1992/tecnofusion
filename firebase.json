{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      ".npm-cache",
      ".cache",
      "test",
      "*-debug.log",
      "*.local"
    ]
  },
  "hosting": [
    {
      "site": "tecnofusion-dev",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": false,
      "headers": [
        {
          "source": "**/*.@(js|mjs)",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/javascript"
            },
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/css"
            },
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        }
      ]
    },
    {
      "site": "tecnofusion-tools",
      "public": "public/tools",
      "redirects": [
        {
          "source": "/",
          "destination": "/pdf-adjuntos/",
          "type": 302
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "bucket": "tecnofuision-it.firebasestorage.app",
      "rules": "storage.rules"
    }
  ]
}