rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Reglas para imágenes y documentos (README) de proyectos
    match /projects/{projectId}/{fileName} {
      // Permitir lectura pública
      allow read: if true;

      // Permitir subida/escritura solo a administradores autenticados con email verificado,
      // limitando tamaño máximo (10MB) y tipos de contenido válidos (imágenes o markdown/texto)
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('text/.*')
            || request.resource.contentType == 'application/octet-stream');

      allow delete: if request.auth != null
        && request.auth.token.email_verified == true;
    }

    // Denegar acceso a todas las demás rutas por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
